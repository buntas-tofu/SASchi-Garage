          "level": "BOUNDED_SOURCE_AND_BASE_R",
          "refs": [
            "over_gate",
            "over_r",
            "over_suite"
          ],
          "covered": "Single-level implicit numeric DO OVER aliases actual row variables and resets scratch/current state each input row and run. Internal position is not an output column. Existing SET and general retention gaps remain separate.",
          "source_tests": [
            "test_scratch_elements_and_current_reset_each_row",
            "test_plan_catalog_and_each_run_are_isolated"
          ]
        },
        {
          "level": "BOUNDED_SOURCE_AND_BASE_R",
          "refs": [
            "counted_gate",
            "counted_r",
            "counted_suite",
            "counted_program"
          ],
          "covered": "Bounded nested/computed counted trees reset per-row work state, preserve input index descriptors and isolate runs. Captured controls and original six-snapshot base-R schedules extend composition evidence without generalizing conditional SET.",
